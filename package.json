{
  "name": "@metatoy/bootstrap-styled",
  "version": "0.1.0",
  "description": "Bootstrap 5 components implemented in styled-components, theme-driven. A modern rewrite of bootstrap-styled/v4.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "play": "vite",
    "play:build": "vite build",
    "prepublishOnly": "npm run build",
    "gen:icons": "node scripts/gen-icons.mjs",
    "parity": "node parity/run.mjs",
    "parity:dev": "vite --config parity/vite.config.ts",
    "docs": "ladle serve",
    "docs:build": "ladle build",
    "docs:preview": "ladle preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.0",
    "bootstrap-icons": "1.13.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=6"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axe-core": "^4.12.1",
    "bootstrap": "5.3.8",
    "jsdom": "^24.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.0.0"
  }
}
